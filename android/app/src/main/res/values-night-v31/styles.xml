<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode Android 12+ system splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/lumio_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_lumio_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lumio_icon_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lumio_splash_background</item>
    </style>
</resources>